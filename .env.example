# Copy to .env and adjust.

# Database (DMERS schema). Default = the bundled Docker "db" service.
# Existing database on your machine, e.g. the original package's Postgres on port 5433:
#   DATABASE_URL=postgresql://dmers:dmers@host.docker.internal:5433/dmers
# Running the API without Docker:
#   DATABASE_URL=postgresql://dmers:dmers@localhost:5433/dmers
DATABASE_URL=postgresql://dmers:dmers@db:5432/dmers
POSTGRES_PASSWORD=dmers

# Long random string; sign-ins are signed with it
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=480
APP_TIMEZONE=Asia/Kolkata

# Apply database/migrations/M*.sql (additive only) when the API starts
DMERS_AUTO_MIGRATE=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

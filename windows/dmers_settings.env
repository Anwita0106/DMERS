# ---------------------------------------------------------------
# DMERS settings for YOUR PostgreSQL (edit, then save)
# ---------------------------------------------------------------
# Port: in pgAdmin right-click "PostgreSQL 18" > Properties > Connection > Port
DB_HOST=localhost
DB_PORT=5433
DB_NAME=dmers_course
DB_USER=postgres
DB_PASSWORD=PUT_YOUR_POSTGRES_PASSWORD_HERE

JWT_SECRET=change-this-to-any-long-random-text-123456789
APP_TIMEZONE=Asia/Kolkata
DMERS_AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:5288,http://127.0.0.1:5288
